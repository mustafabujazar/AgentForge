# =============================================================================
# AgentForge — environment template  (source of truth: app/core/config.py)
#
# Copy to .env and fill in real values:
#     PowerShell:  Copy-Item .env.example .env
#     bash:        cp .env.example .env
#
# Never commit .env or real API keys. Unset variables fall back to the defaults
# listed in app/core/config.py. `docker compose` also reads this file for
# interpolation, and passes it to the backend via env_file.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=AgentForge
APP_VERSION=1.0.0
# development | staging | production  (APP_ENV wins over legacy ENVIRONMENT)
APP_ENV=development
# Legacy alias, only consulted when APP_ENV is empty. Prefer APP_ENV.
ENVIRONMENT=
DEBUG=false

# ---------------------------------------------------------------------------
# Security / auth
# ---------------------------------------------------------------------------
# HS256 JWT signing key. MUST be replaced with a long random value in any
# shared/production environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
# JWT lifetime in minutes (default 12h).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Demo account seeded on first start (docs/API_CONTRACT.md auth section).
DEMO_USER_EMAIL=demo@agentforge.io
DEMO_USER_PASSWORD=demo1234
DEMO_USER_NAME=Demo Operator

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development default: SQLite file (no server needed). Empty = built-in
# default under data/agentforge.db.
DATABASE_URL=sqlite:///./data/agentforge.db
# PostgreSQL + pgvector (docker compose overrides this path automatically):
# DATABASE_URL=postgresql+psycopg://agentforge:agentforge@postgres:5432/agentforge
# Echo SQL statements to the log (dev only; SQLite only).
SQLITE_ECHO=false

# ---------------------------------------------------------------------------
# LLM provider abstraction (app/llm)
# ---------------------------------------------------------------------------
# groq | openai | ollama | mock
# `mock` is deterministic and offline — use it for tests and demos without
# keys. If LLM_PROVIDER is unset, the provider is inferred from which
# credentials are configured (GROQ_API_KEY -> groq, then OpenAI, then Ollama,
# otherwise mock).
LLM_PROVIDER=groq
# Model id for the selected provider. Falls back to GROQ_MODEL for backwards
# compatibility when LLM_MODEL is empty.
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_SECONDS=90
# Hard budget per run; protects against runaway retry loops.
LLM_MAX_CALLS_PER_RUN=40
# Rolling tokens-per-minute budget (0 disables pacing). Free Groq tier = 8000 TPM.
LLM_TPM_LIMIT=8000
LLM_RATE_LIMIT_SAFETY=0.9

# Provider credentials / endpoints. Leave blank for mock or ollama.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Legacy fallback, only consulted when LLM_MODEL is empty. Prefer LLM_MODEL.
GROQ_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Orchestration / quality gates
# ---------------------------------------------------------------------------
# Retries per task after a failed evaluation.
MAX_AGENT_RETRIES=2
# Evaluator score (0–1) at or above which a task passes.
EVAL_PASS_SCORE=0.72
# Per-step (agent/tool) timeout in seconds.
STEP_TIMEOUT_SECONDS=240
# Human-in-the-loop gate for sensitive tools.
HITL_ENABLED=true
# DANGEROUS: auto-approve every sensitive action. Keep false except in demos.
AUTO_APPROVE_DEFAULT=false
# Planner sampling temperature (low = more deterministic plans).
PLANNER_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# RAG / embeddings (deterministic local embeddings; no external service)
# ---------------------------------------------------------------------------
EMBEDDING_DIM=384
RAG_TOP_K=5
RAG_MIN_SCORE=0.08
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

# ---------------------------------------------------------------------------
# Paths (relative paths resolve from the process working directory; empty =
# PROJECT_ROOT defaults). The container sets these to /app/... explicitly.
# ---------------------------------------------------------------------------
SALES_DB_PATH=data/demo/sales.db
KNOWLEDGE_DIR=data/knowledge
ARTIFACTS_DIR=artifacts
# Directory containing the built SPA that FastAPI serves at "/".
FRONTEND_DIST_DIR=frontend/dist

# ---------------------------------------------------------------------------
# API / CORS
# ---------------------------------------------------------------------------
# Comma-separated allowed origins. Include the Vite dev server and the
# same-origin backend URL; restrict to your real domain in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Logging / observability (see docs/observability.md)
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = one JSON object per line (container-friendly); false = human-readable.
LOG_JSON=true

# LangSmith tracing (optional; uses the installed `langsmith` package).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentforge

# OpenTelemetry collector (optional compose profile `observability`).
# The app ships only opentelemetry-api — no exporter is wired yet.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=agentforge-backend
# OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.104.0

# ---------------------------------------------------------------------------
# Docker Compose only — Postgres container credentials
# (keep in sync with the backend DATABASE_URL when you override them)
# ---------------------------------------------------------------------------
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge

# Optional frontend build argument (empty = same-origin /api).
# VITE_API_BASE_URL=



LLM_REASONING_EFFORT=low
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b
