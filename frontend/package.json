{
  "name": "agentforge-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AgentForge mission-control dashboard (React + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && node scripts/build-fallback.mjs",
    "build:vite": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-build.mjs",
    "verify:ssr": "tsc -p tsconfig.ssr.json && node scripts/run-ssr-smoke.mjs",
    "preview:mock": "python scripts/mock_api.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
