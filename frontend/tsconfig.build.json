{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist/assets/modules",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "allowUmdGlobalAccess": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "isolatedModules": false,
    "removeComments": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.*"]
}
